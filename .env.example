# KaamSetu Environment Configuration
DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV=development

# Session signing secret (32+ random characters). REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Local development only: login OTP is always 1234 and is returned by /auth/send-otp.
# Ignored when NODE_ENV=production.
OTP_DEV_MODE=true

# SMS provider for login OTPs (MSG91, DLT-registered template with an ##otp## variable)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Google Maps JavaScript API Key (optional in development - placeholder fallback is shown)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
